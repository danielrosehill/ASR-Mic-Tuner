[Desktop Entry]
Type=Application
Name=Mic Monitor
GenericName=Microphone Monitor
Comment=Microphone gain, level, noise and voice analysis for dictation
Exec=mic-monitor
Icon=audio-input-microphone
Categories=AudioVideo;Audio;Settings;Qt;KDE;
Keywords=microphone;mic;gain;level;meter;clipping;dictation;noise;asr;speech;monitor;
StartupWMClass=mic-monitor
Terminal=false
Actions=Tray;

[Desktop Action Tray]
Name=Start in tray
Exec=mic-monitor --tray
